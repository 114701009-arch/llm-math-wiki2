  <script>
    // 投影片目錄清單
    const slideTitles = [
      "01. 封面：貫穿高中數學的統一之道",
      "02. 思維困局：為什麼高中數學讓人覺得破碎？",
      "03. 拼圖一：多項式代數與函數空間種子",
      "04. 拼圖二：三角函數與二維旋轉本質",
      "05. 拼圖三：平面向量與基底幾何",
      "06. 拼圖四：空間向量與維度飛躍",
      "07. 拼圖五：矩陣與空間幾何變換",
      "08. 大一統時刻：什麼是真正的「向量」？",
      "09. 串聯大橋 1：多項式即向量空間，微積分即矩陣",
      "10. 串聯大橋 2：三角和角公式就是矩陣複合",
      "11. 串聯大橋 3：幾何向量與行列式體積大一統",
      "12. 互動實驗室：即時平面矩陣幾何變換體驗",
      "13. 思維登頂：帶著線性代數走出迷霧"
    ];

    let currentSlide = 0;
    const slides = document.querySelectorAll('.slide');
    const totalSlides = slides.length;
    const progressBar = document.getElementById('progressBar');
    const slideCounter = document.getElementById('slideCounter');
    const prevBtn = document.getElementById('prevBtn');
    const nextBtn = document.getElementById('nextBtn');
    const drawerOverlay = document.getElementById('drawerOverlay');
    const drawer = document.getElementById('drawer');
    const drawerBtn = document.getElementById('drawerBtn');
    const closeDrawerBtn = document.getElementById('closeDrawerBtn');
    const drawerList = document.getElementById('drawerList');
    const fullscreenBtn = document.getElementById('fullscreenBtn');
    const themeBtn = document.getElementById('themeBtn');
    const themeIcon = document.getElementById('themeIcon');

    // 建立大綱列表
    slideTitles.forEach((title, index) => {
      const li = document.createElement('li');
      li.className = `drawer-item ${index === 0 ? 'active' : ''}`;
      li.innerText = title;
      li.addEventListener('click', () => {
        goToSlide(index);
        toggleDrawer(false);
      });
      drawerList.appendChild(li);
    });

    // 跳轉投影片核心函數
    function goToSlide(index) {
      if (index < 0) index = 0;
      if (index >= totalSlides) index = totalSlides - 1;

      slides[currentSlide].classList.remove('active');
      currentSlide = index;
      slides[currentSlide].classList.add('active');

      // 更新進度條與頁碼
      const progressPercent = ((currentSlide + 1) / totalSlides) * 100;
      progressBar.style.width = `${progressPercent}%`;
      slideCounter.innerText = `${currentSlide + 1} / ${totalSlides}`;

      // 更新側邊選單高亮
      const drawerItems = document.querySelectorAll('.drawer-item');
      drawerItems.forEach((item, idx) => {
        if (idx === currentSlide) {
          item.classList.add('active');
        } else {
          item.classList.remove('active');
        }
      });

      // 如果切到互動實驗室 (Slide 12)，觸發一次重繪
      if (currentSlide === 11) {
        renderSimulation();
      }
    }

    // 上一頁 / 下一頁
    prevBtn.addEventListener('click', () => goToSlide(currentSlide - 1));
    nextBtn.addEventListener('click', () => goToSlide(currentSlide + 1));

    // 鍵盤監聽事件
    window.addEventListener('keydown', (e) => {
      if (e.target.tagName === 'INPUT' || e.target.tagName === 'TEXTAREA') return;

      switch(e.key) {
        case 'ArrowRight':
        case 'ArrowDown':
        case ' ':
        case 'PageDown':
          e.preventDefault();
          goToSlide(currentSlide + 1);
          break;
        case 'ArrowLeft':
        case 'ArrowUp':
        case 'PageUp':
          e.preventDefault();
          goToSlide(currentSlide - 1);
          break;
        case 'Home':
          e.preventDefault();
          goToSlide(0);
          break;
        case 'End':
          e.preventDefault();
          goToSlide(totalSlides - 1);
          break;
        case 'o':
        case 'O':
          e.preventDefault();
          toggleDrawer();
          break;
        case 'f':
        case 'F':
          e.preventDefault();
          toggleFullscreen();
          break;
        case 't':
        case 'T':
          e.preventDefault();
          toggleTheme();
          break;
        case 'Escape':
          if (drawer.classList.contains('open')) {
            toggleDrawer(false);
          }
          break;
      }
    });

    // 大綱選單開關
    function toggleDrawer(forceState) {
      const isOpen = forceState !== undefined ? forceState : !drawer.classList.contains('open');
      if (isOpen) {
        drawer.classList.add('open');
        drawerOverlay.classList.add('open');
      } else {
        drawer.classList.remove('open');
        drawerOverlay.classList.remove('open');
      }
    }

    drawerBtn.addEventListener('click', () => toggleDrawer());
    closeDrawerBtn.addEventListener('click', () => toggleDrawer(false));
    drawerOverlay.addEventListener('click', () => toggleDrawer(false));

    // 全螢幕切換
    function toggleFullscreen() {
      if (!document.fullscreenElement) {
        document.documentElement.requestFullscreen().catch(err => {
          console.log(`全螢幕請求失敗: ${err.message}`);
        });
      } else {
        if (document.exitFullscreen) {
          document.exitFullscreen();
        }
      }
    }
    fullscreenBtn.addEventListener('click', toggleFullscreen);

    // 一鍵下載此 HTML 簡報檔案
    const downloadBtn = document.getElementById('downloadBtn');
    downloadBtn.addEventListener('click', () => {
      // 複製當前 HTML 字串並產生下載連結
      const htmlString = "<!DOCTYPE html>\n" + document.documentElement.outerHTML;
      const blob = new Blob([htmlString], { type: 'text/html;charset=utf-8' });
      const url = URL.createObjectURL(blob);
      const a = document.createElement('a');
      a.href = url;
      a.download = '貫穿高中數學到線性代數大一統教學簡報.html';
      document.body.appendChild(a);
      a.click();
      document.body.removeChild(a);
      URL.revokeObjectURL(url);
    });

    // 深色 / 淺色主題切換
    function toggleTheme() {
      const currentTheme = document.body.getAttribute('data-theme');
      if (currentTheme === 'light') {
        document.body.removeAttribute('data-theme');
        themeIcon.innerText = '☀️';
      } else {
        document.body.setAttribute('data-theme', 'light');
        themeIcon.innerText = '🌙';
      }
      renderSimulation();
    }
    themeBtn.addEventListener('click', toggleTheme);

    // ==========================================
    // 互動實驗室 (Slide 12: Matrix Simulator)
    // ==========================================
    const simCanvas = document.getElementById('simCanvas');
    const ctx = simCanvas.getContext('2d');
    const angleSlider = document.getElementById('angleSlider');
    const scaleSlider = document.getElementById('scaleSlider');
    const shearSlider = document.getElementById('shearSlider');
    const angleVal = document.getElementById('angleVal');
    const scaleVal = document.getElementById('scaleVal');
    const shearVal = document.getElementById('shearVal');
    const matrixDisplay = document.getElementById('matrixDisplay');
    const detDisplay = document.getElementById('detDisplay');

    function renderSimulation() {
      if (!simCanvas) return;
      const deg = parseFloat(angleSlider.value);
      const s = parseFloat(scaleSlider.value);
      const k = parseFloat(shearSlider.value);

      angleVal.innerText = `${deg}°`;
      scaleVal.innerText = `${s.toFixed(1)}x`;
      shearVal.innerText = `${k.toFixed(1)}`;

      const rad = (deg * Math.PI) / 180;
      const cos = Math.cos(rad);
      const sin = Math.sin(rad);

      // 複合矩陣 M = [s*cos - s*sin] * [1  k]
      //             [s*sin   s*cos]   [0  1]
      // 第一列: [s*cos,  s*cos*k - s*sin]
      // 第二列: [s*sin,  s*sin*k + s*cos]
      const m11 = s * cos;
      const m12 = s * (cos * k - sin);
      const m21 = s * sin;
      const m22 = s * (sin * k + cos);
      const det = (m11 * m22 - m12 * m21);

      matrixDisplay.innerHTML = `[ ${m11 >= 0 ? ' ' : ''}${m11.toFixed(2)}  ${m12 >= 0 ? ' ' : ''}${m12.toFixed(2)} ]<br>[ ${m21 >= 0 ? ' ' : ''}${m21.toFixed(2)}  ${m22 >= 0 ? ' ' : ''}${m22.toFixed(2)} ]`;
      detDisplay.innerText = det.toFixed(2);

      const w = simCanvas.width;
      const h = simCanvas.height;
      const cx = w / 2;
      const cy = h / 2;
      const unit = 60; // 每個單位長度的像素

      ctx.clearRect(0, 0, w, h);

      // 繪製背景參考格線
      ctx.strokeStyle = "rgba(255, 255, 255, 0.08)";
      ctx.lineWidth = 1;
      for (let x = -4; x <= 4; x++) {
        ctx.beginPath();
        ctx.moveTo(cx + x * unit, 0);
        ctx.lineTo(cx + x * unit, h);
        ctx.stroke();
      }
      for (let y = -4; y <= 4; y++) {
        ctx.beginPath();
        ctx.moveTo(0, cy + y * unit);
        ctx.lineTo(w, cy + y * unit);
        ctx.stroke();
      }

      // 繪製坐標軸
      ctx.strokeStyle = "rgba(255, 255, 255, 0.3)";
      ctx.lineWidth = 2;
      ctx.beginPath();
      ctx.moveTo(0, cy);
      ctx.lineTo(w, cy);
      ctx.moveTo(cx, 0);
      ctx.lineTo(cx, h);
      ctx.stroke();

      // 繪製變換後的變形網格區域 (平行四邊形)
      // 頂點: (0,0), (m11, m21), (m11+m12, m21+m22), (m12, m22)
      ctx.fillStyle = "rgba(99, 102, 241, 0.25)";
      ctx.strokeStyle = "rgba(99, 102, 241, 0.7)";
      ctx.beginPath();
      ctx.moveTo(cx, cy);
      ctx.lineTo(cx + m11 * unit, cy - m21 * unit);
      ctx.lineTo(cx + (m11 + m12) * unit, cy - (m21 + m22) * unit);
      ctx.lineTo(cx + m12 * unit, cy - m22 * unit);
      ctx.closePath();
      ctx.fill();
      ctx.stroke();

      // 繪製變換後的基底 i (紅色箭頭)
      drawArrow(ctx, cx, cy, cx + m11 * unit, cy - m21 * unit, "#f43f5e", 3, "i'");
      // 繪製變換後的基底 j (綠色箭頭)
      drawArrow(ctx, cx, cy, cx + m12 * unit, cy - m22 * unit, "#10b981", 3, "j'");
    }

    function drawArrow(context, fromx, fromy, tox, toy, color, width, label) {
      const headlen = 10;
      const dx = tox - fromx;
      const dy = toy - fromy;
      const angle = Math.atan2(dy, dx);

      context.strokeStyle = color;
      context.fillStyle = color;
      context.lineWidth = width;

      context.beginPath();
      context.moveTo(fromx, fromy);
      context.lineTo(tox, toy);
      context.stroke();

      context.beginPath();
      context.moveTo(tox, toy);
      context.lineTo(tox - headlen * Math.cos(angle - Math.PI / 6), toy - headlen * Math.sin(angle - Math.PI / 6));
      context.lineTo(tox - headlen * Math.cos(angle + Math.PI / 6), toy - headlen * Math.sin(angle + Math.PI / 6));
      context.closePath();
      context.fill();

      // 繪製標籤
      context.font = "bold 14px Consolas, monospace";
      context.fillText(label, tox + 8 * Math.cos(angle), toy + 8 * Math.sin(angle));
    }

    angleSlider.addEventListener('input', renderSimulation);
    scaleSlider.addEventListener('input', renderSimulation);
    shearSlider.addEventListener('input', renderSimulation);

    // 渲染數學 LaTeX 公式
    function renderMath() {
      if (window.renderMathInElement) {
        renderMathInElement(document.body, {
          delimiters: [
            {left: '$$', right: '$$', display: true},
            {left: '$', right: '$', display: false},
            {left: '\\(', right: '\\)', display: false},
            {left: '\\[', right: '\\]', display: true}
          ],
          throwOnError: false
        });
      } else {
        // 離線備援排版：若無網路載入 KaTeX CDN，使用純 HTML/CSS 幾何與矩陣優雅替換，杜絕顯示為程式碼
        document.querySelectorAll('.formula-box, .card p, .card li').forEach(el => {
          let html = el.innerHTML;
          // 替換矩陣語法 \begin{bmatrix} ... \end{bmatrix} 為帶括號的離線美觀表格
          html = html.replace(/\\begin\{bmatrix\}([\s\S]*?)\\end\{bmatrix\}/g, function(_, inner) {
            let rows = inner.trim().split('\\\\').map(r => {
              let cols = r.split('&').map(c => `<td>${c.trim()}</td>`).join('');
              return `<tr>${cols}</tr>`;
            }).join('');
            return `<table class="offline-matrix">${rows}</table>`;
          });
          // 替換常用希臘字母與數學符號
          html = html.replace(/\\cos/g, 'cos')
                     .replace(/\\sin/g, 'sin')
                     .replace(/\\alpha/g, 'α')
                     .replace(/\\beta/g, 'β')
                     .replace(/\\theta/g, 'θ')
                     .replace(/\\phi/g, 'φ')
                     .replace(/\\lambda/g, 'λ')
                     .replace(/\\vec\{([a-zA-Z])\}/g, '<span style="text-decoration: overline;">$1</span>&#x20D7;')
                     .replace(/\\det/g, 'det')
                     .replace(/\\mathbb\{R\}/g, 'ℝ')
                     .replace(/\\in/g, '∈')
                     .replace(/\\implies/g, '⟹')
                     .replace(/\\iff/g, '⟺')
                     .replace(/\\ge/g, '≥')
                     .replace(/\\le/g, '≤')
                     .replace(/\$\$/g, '')
                     .replace(/\$/g, '');
          el.innerHTML = html;
        });
      }
    }

    // 頁面加載完成後執行數學排版
    window.addEventListener('DOMContentLoaded', renderMath);
    window.addEventListener('load', renderMath);
    setTimeout(renderMath, 600); // 確保非同步載入的 KaTeX 順利渲染

    // 初始化渲染
    goToSlide(0);
    renderSimulation();
  </script>
</body>
</html>

# RAW 01: 高中多項式函數原始文獻與綱要 (Polynomials)

來源：108 課綱高中數學第一冊（高一上）第三章 多項式函數

## 核心綱要與原始摘錄：
1. 一元多項式的定義：以實數為係數之代數式 P(x) = a_n x^n + ... + a_1 x + a_0。
2. 多項式的四則運算：加法、減法與乘法之封閉性。
3. 除法原理：設 f(x), g(x) 為多項式且 g(x) ≠ 0，則存在唯一的多項式 q(x) 與 r(x)，滿足 f(x) = g(x)q(x) + r(x)，其中 r(x) = 0 或 deg r(x) < deg g(x)。
4. 餘式定理：多項式 f(x) 除以 x - c 的餘式為常數 f(c)。
5. 因式定理：f(c) = 0 當且僅當 (x - c) 為 f(x) 的因式。
6. 插值多項式：通過平面上相異 n+1 個點之最低次多項式恰有唯一解（拉格朗日插值法）。插值之本質為給定 n+1 個約束條件決定 n+1 個待定係數。
7. 現代數學對照：多項式集合在加法與純量乘法下構成有限維向量空間 P_n，其標準基底為 {1, x, x^2, ..., x^n}。拉格朗日插值可寫成 Vandermonde 矩陣方程組。

# RAW 02: 高中三角函數原始文獻與綱要 (Trigonometric Functions)

來源：108 課綱高中數學第二冊（高一下）及第三冊（高二上）三角函數章節

## 核心綱要與原始摘錄：
1. 銳角三角比：正弦 sinθ、餘弦 cosθ、正切 tanθ 於直角三角形之邊長比例定義。
2. 廣義角與單位圓：以直角座標系原點為圓心、半徑為 1 之單位圓 x^2 + y^2 = 1，終邊交點 P 之座標嚴格定義為 (cosθ, sinθ)。
3. 商高恆等式：cos^2(θ) + sin^2(θ) = 1。
4. 弧度制（弳度）：半徑與弧長相等之圓心角為 1 弧度（1 rad），π rad = 180°。
5. 三角函數圖形特徵：y = sin x 與 y = cos x 之週期性（2π）、振幅（1）、奇偶性對稱。
6. 和角與差角公式：
   - cos(α + β) = cosα cosβ - sinα sinβ
   - sin(α + β) = sinα cosβ + cosα sinβ
7. 現代數學對照：和角公式在代數幾何上等價於平面二維旋轉變換的複合，對應特殊正交群 SO(2) 的矩陣相乘。三角多項式在區間 [-π, π] 上構成無窮維希爾伯特空間的正交基底。

# RAW 03: 高中平面向量原始文獻與綱要 (Plane Vectors)

來源：108 課綱高中數學第三冊（高二上）平面向量章節

## 核心綱要與原始摘錄：
1. 向量的定義：兼具大小與方向之幾何量，以有向線段 AB 表示，平移不變。
2. 向量的座標表示法：在笛卡兒坐標系中以 (x, y) 表示，標準基底為 i = (1, 0), j = (0, 1)。
3. 向量加減法與純量乘法：三角形法則、平行四邊形法則；向量加法與實數倍數之封閉性。
4. 線性組合與分點公式：兩非平行非零向量 a, b 可唯一線性組合出平面上任意向量 p = x a + y b。
5. 內積（純量積 Dot Product）：
   - 幾何定義：a · b = |a| |b| cosθ
   - 代數座標：a · b = a1 b1 + a2 b2
   - 垂直判別：a · b = 0 當且僅當 a 垂直 b
6. 正射影向量：proj_b a = ((a · b) / |b|^2) b。
7. 柯西不等式：(a1^2 + a2^2)(b1^2 + b2^2) ≥ (a1 b1 + a2 b2)^2。
8. 現代數學對照：R^2 是最基礎的二維歐幾里得向量空間，二階行列式 det([a, b]) 代表有向平行四邊形面積。

# RAW 04: 高中空間向量與幾何原始文獻與綱要 (Space Vectors)

來源：108 課綱高中數學第四冊（高二下）空間向量與立體幾何章節

## 核心綱要與原始摘錄：
1. 空間直角坐標系：x, y, z 軸與原點 O，任意點 P(x, y, z) 與空間向量 v = (x, y, z)。
2. 空間向量模長與內積：|v| = sqrt(x^2 + y^2 + z^2)，a · b = a1 b1 + a2 b2 + a3 b3。
3. 空間平面的點法式：法向量 n = (A, B, C)，平面方程式 Ax + By + Cz + D = 0。
4. 空間直線方程式：過點 P0 方向向量 d = (l, m, n) 之參數式與對稱比例式。
5. 外積（向量積 Cross Product）：
   - 僅在三維空間定義：a × b 同時垂直於 a 與 b，右手定則決定方向。
   - 大小：|a × b| = |a| |b| sinθ（等於平行四邊形面積）。
   - 座標展開公式：使用二階行列式交叉展開。
6. 純量三重積（Scalar Triple Product）與三階行列式：
   - 平行六面體體積 V = (a × b) · c = det([a, b, c])。
   - 若三向量共面，則 det = 0（體積崩塌為零）。
7. 現代數學對照：外積對應外代數（Exterior Algebra）中的楔積 a ∧ b，三階行列式本質為多重線性交替形式（體積形式）。

# RAW 05: 高中矩陣與線性方程組原始文獻與綱要 (Matrices)

來源：108 課綱高中數學第四冊（高二下選修）矩陣與方程組章節

## 核心綱要與原始摘錄：
1. 矩陣的定義與基本運算：m × n 矩形實數陣列，加法、純量乘法與非交換的矩陣乘法。
2. 線性聯立方程組與增廣矩陣：利用列基本運算（列對調、列純量乘法、列加減）進行高斯消去法，判定唯一解、無窮多解或無解。
3. 二階平面幾何變換矩陣：
   - 旋轉矩陣：R_θ = [[cosθ, -sinθ], [sinθ, cosθ]]
   - 鏡射矩陣：M_θ = [[cos2θ, sin2θ], [sin2θ, -cos2θ]]
   - 伸縮矩陣：S = [[h, 0], [0, k]]
   - 推移矩陣：T = [[1, k], [0, 1]]
4. 轉移矩陣與馬可夫鏈：隨機矩陣之每行元素和為 1，求長期穩定狀態 PX = X。
5. 現代數學對照：
   - 矩陣的行視角（Column Picture）：矩陣乘以向量即對其直行做線性組合，每行代表標準基底經變換後的落點。
   - 矩陣乘法為線性映射的複合運算：(AB)v = A(Bv)。
   - 行列式 det(M) 代表空間幾何圖形的面積/體積放大率；det(M) = 0 表示變換將空間降維壓扁。

